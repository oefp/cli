{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OEFP entry metadata",
  "type": "object",
  "required": ["id", "title", "description", "tags"],
  "allOf": [{
    "if": {"properties": {"id": {"pattern": "^T"}}, "required": ["id"]},
    "then": {"required": ["status"]}
  }],
  "properties": {
    "id": {"type": "string", "pattern": "^[TD][0-9]{8}$"},
    "title": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "description": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(?:[^/?#]+\\.)?(?:wikipedia\\.org|arxiv\\.org|doi\\.org|encyclopediaofmath\\.org|mathworld\\.wolfram\\.com|planetmath\\.org)(?:[/?#]|$)"
      }
    },
    "status": {"type": "string", "enum": ["proved", "open"]}
  },
  "additionalProperties": false
}
